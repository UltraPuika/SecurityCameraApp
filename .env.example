# Copy to .env and fill in. Never commit .env.

# Web port and bind address on the host. Keep 127.0.0.1 unless a VPN/reverse proxy
# on this host needs another address (see README "Remote access").
CAMDASH_WEB_PORT=8080
CAMDASH_BIND_ADDRESS=127.0.0.1

# Key that encrypts camera credentials in the database. Generate once and back it up:
#   docker run --rm python:3.13-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
# Losing it makes stored camera passwords unrecoverable.
CAMDASH_ENCRYPTION_KEY=

# Initial admin, created on first start only (min. 12 characters). You may remove
# the password from this file after the first successful login.
CAMDASH_ADMIN_USERNAME=admin
CAMDASH_ADMIN_PASSWORD=

# Session cookies are Secure (HTTPS-only) by default. Browsers also accept them on
# http://localhost. Set to false ONLY for plain-HTTP testing from another LAN device.
CAMDASH_COOKIE_SECURE=true

# Only if sign-in fails with "Request blocked" behind a reverse proxy (e.g. tailscale
# serve): list the address you open in the browser, e.g. https://camdash.tail1234.ts.net
CAMDASH_TRUSTED_ORIGINS=

CAMDASH_SESSION_TTL_HOURS=168
CAMDASH_LOGIN_MAX_FAILURES=5
CAMDASH_LOGIN_WINDOW_SECONDS=900

# Cameras must be on private/VPN ranges (RFC 1918, 100.64.0.0/10, fc00::/7).
# Add extra CIDRs here only if a camera really lives elsewhere (comma-separated).
CAMDASH_ALLOWED_CAMERA_NETWORKS=
# Per-step timeout for connection tests (seconds).
CAMDASH_PROBE_TIMEOUT_SECONDS=8

# Stop a camera stream this many seconds after the last viewer leaves.
CAMDASH_STREAM_IDLE_SECONDS=60
# Max simultaneous camera streams (one upstream each). Not yet measured on a Pi 5.
CAMDASH_MAX_STREAMS=6
